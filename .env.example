# Public canonical URL used for SEO metadata, robots.txt and sitemap.xml.
# Use localhost during development; replace it with your HTTPS domain later.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEFAULT_STORE_SLUG=demo
# Keep this equal to DEFAULT_STORE_SLUG so browser-side links use clean root URLs.
NEXT_PUBLIC_DEFAULT_STORE_SLUG=demo

# Use a unique long random value in every production environment.
JWT_SECRET=replace-with-a-long-random-secret

# Server-only Supabase credentials (Project Settings -> API Keys).
# Prefer the new sb_secret_... key. Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Direct/session-pooler Postgres connection string used only by startup migrations.
# Copy it from the Supabase project's Connect panel and replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres

# Instead of DATABASE_URL, the same connection may be supplied as components.
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password
